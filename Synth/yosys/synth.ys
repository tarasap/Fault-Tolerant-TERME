read_verilog src/Backend.v
read_verilog src/ALU.v
read_verilog src/ALU_Lane.v
read_verilog src/ALU_Decoder.v
read_verilog src/Branch_Unit.v
read_verilog src/Memory_WriteBack.v
read_verilog src/Frontend.v
read_verilog src/ECC_Decoder.v
read_verilog src/CSRs.v
read_verilog src/CSR_Controller.v
read_verilog src/ECC_Encoder.v
read_verilog src/TERME_Protected.v
read_verilog src/Decode_Execute.v
read_verilog src/Decompressor.v
read_verilog src/Decoder2.v
read_verilog src/Decoder1.v
read_verilog src/Hazard_Unit.v
read_verilog src/Instruction_Load_Unit.v
read_verilog src/Sign_Extension.v
read_verilog src/ECC_Corrector.v
read_verilog src/TERME_Controller.v
read_verilog src/Load_Store_Unit.v
read_verilog src/Zmmul_Decoder.v
read_verilog src/Mul_Unit.v
read_verilog src/Regfile.v
read_verilog src/FE_Comparator.v
read_verilog src/Majority_Voter.v
