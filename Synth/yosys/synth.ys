read_verilog src/Pipe_Manager.v


hierarchy -check -top TERME_Protected

# Protect redundant blocks: they survive flatten, opt_merge and ABC
setattr -mod -set keep 1 TERME_Controller Frontend Backend ALU_Lane \
        ECC_Corrector ECC_Decoder ECC_Encoder Mul_Unit Majority_Voter
setattr -mod -set keep_hierarchy 1 TERME_Controller Frontend Backend ALU_Lane \
        ECC_Corrector ECC_Decoder ECC_Encoder Mul_Unit Majority_Voter

synth -top TERME_Protected
flatten       # flattens everything except keep_hierarchy modules

read_liberty -lib cell/stdcell.lib 
dfflibmap -liberty cell/stdcell.lib 

abc -liberty cell/stdcell.lib 

opt -full
clean

select -list t:Frontend
select -list t:Backend
select -list t:TERME_Controller
select -list t:ALU_Lane
select -list t:ECC_Corrector
select -list t:ECC_Decoder
select -list t:ECC_Encoder
select -list t:Mul_Unit
select -list t:Majority_Voter

tee -o report.txt stat -liberty cell\stdcell.lib

#setundef -zero
setundef -zero
write_verilog -noattr TERME_Protected.v
stat -liberty cell/stdcell.lib -top TERME_Protected